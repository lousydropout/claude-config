{
  "env": {
    "MAX_THINKING_TOKENS": "32000"
  },
  "permissions": {
    "allow": [
      "Bash(./hack/spec_metadata.sh)",
      "Bash(hack/spec_metadata.sh)",
      "Bash(bash hack/spec_metadata.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git fetch:*)",
      "Bash(git reset:*)",
      "Bash(git config:*)",
      "Bash(node:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(nvm:*)",
      "Bash(yarn:*)",
      "Bash(ls:*)",
      "Bash(basename:*)",
      "Bash(pwd:*)",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(ps:*)",
      "Bash(kill:*)",
      "Bash(which:*)",
      "Bash(docker:*)",
      "Bash(make:*)",
      "Bash(cargo:*)",
      "Bash(curl:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sqlite3:*)",
      "Bash(less:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[CONTEXT LIMIT REACHED] Before compacting, spawn a sub-agent to create a handoff document. Use: Task tool with subagent_type=handoff-creator and prompt: Create a handoff document for the current session. After the sub-agent completes, proceed with /compact.'"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": false
}
